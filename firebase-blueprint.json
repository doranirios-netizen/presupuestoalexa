{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user profile and monthly budget configuration isolated per authenticated account.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Authenticated user UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name shown in the dashboard and assistant.",
          "minLength": 1,
          "maxLength": 60
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Account email address (private PII).",
          "maxLength": 160
        },
        "baseMonthlyBudget": {
          "type": "number",
          "description": "Monthly budget in COP configured by the user."
        },
        "hasConfiguredBudget": {
          "type": "boolean",
          "description": "Whether the user has completed the first-time monthly budget prompt."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the user profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the user profile was last updated."
        }
      },
      "required": [
        "uid",
        "displayName",
        "baseMonthlyBudget",
        "hasConfiguredBudget",
        "createdAt",
        "updatedAt"
      ]
    },
    "Movement": {
      "title": "Movement",
      "description": "An expense or income movement belonging exclusively to a single user account.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document identifier matching the movement path ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the user who owns this movement.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["expense", "income"],
          "description": "Movement type."
        },
        "day": {
          "type": "number",
          "description": "Day of month (1-31)."
        },
        "dateISO": {
          "type": "string",
          "description": "ISO calendar date YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "dateLabel": {
          "type": "string",
          "description": "Formatted short Spanish date label.",
          "minLength": 1,
          "maxLength": 40
        },
        "fullDateLabel": {
          "type": "string",
          "description": "Formatted full Spanish date label.",
          "minLength": 1,
          "maxLength": 80
        },
        "weekdayShort": {
          "type": "string",
          "description": "Short Spanish weekday abbreviation.",
          "minLength": 1,
          "maxLength": 12
        },
        "timeLabel": {
          "type": "string",
          "description": "24-hour time HH:MM.",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "description": {
          "type": "string",
          "description": "Movement title or description.",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "description": "Expense or income category.",
          "minLength": 1,
          "maxLength": 60
        },
        "paymentMethod": {
          "type": "string",
          "description": "Optional payment method used for income movements.",
          "maxLength": 40
        },
        "amount": {
          "type": "number",
          "description": "Positive amount in COP (> 0)."
        },
        "notes": {
          "type": "string",
          "description": "Additional notes for the movement.",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the movement was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the movement was last updated."
        }
      },
      "required": [
        "id",
        "ownerId",
        "type",
        "day",
        "dateISO",
        "dateLabel",
        "fullDateLabel",
        "weekdayShort",
        "timeLabel",
        "description",
        "category",
        "amount",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores each authenticated user's profile and monthly budget configuration."
    },
    "/users/{userId}/movements/{movementId}": {
      "schema": { "$ref": "#/entities/Movement" },
      "description": "Stores private expense and income movements scoped exclusively to {userId}."
    }
  }
}
