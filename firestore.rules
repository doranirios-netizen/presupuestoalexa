rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Security Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 3. Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'baseMonthlyBudget',
        'hasConfiguredBudget',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'displayName',
        'email',
        'baseMonthlyBudget',
        'hasConfiguredBudget',
        'createdAt',
        'updatedAt'
      ])
      && data.uid is string
      && data.uid == userId
      && isValidId(data.uid)
      && data.displayName is string
      && data.displayName.size() >= 1
      && data.displayName.size() <= 60
      && (!('email' in data) || (data.email is string && data.email.size() <= 160))
      && data.baseMonthlyBudget is number
      && data.baseMonthlyBudget >= 0
      && data.baseMonthlyBudget <= 100000000000
      && data.hasConfiguredBudget is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidMovement(data, userId, movementId) {
      return data.keys().hasAll([
        'id',
        'ownerId',
        'type',
        'day',
        'dateISO',
        'dateLabel',
        'fullDateLabel',
        'weekdayShort',
        'timeLabel',
        'description',
        'category',
        'amount',
        'notes',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'id',
        'ownerId',
        'type',
        'day',
        'dateISO',
        'dateLabel',
        'fullDateLabel',
        'weekdayShort',
        'timeLabel',
        'description',
        'category',
        'paymentMethod',
        'amount',
        'notes',
        'createdAt',
        'updatedAt'
      ])
      && data.id is string
      && data.id == movementId
      && isValidId(data.id)
      && data.ownerId is string
      && data.ownerId == userId
      && isValidId(data.ownerId)
      && data.type is string
      && (data.type == 'expense' || data.type == 'income')
      && data.day is number
      && data.day >= 1
      && data.day <= 31
      && data.dateISO is string
      && data.dateISO.size() == 10
      && data.dateISO.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && data.dateLabel is string
      && data.dateLabel.size() >= 1
      && data.dateLabel.size() <= 40
      && data.fullDateLabel is string
      && data.fullDateLabel.size() >= 1
      && data.fullDateLabel.size() <= 80
      && data.weekdayShort is string
      && data.weekdayShort.size() >= 1
      && data.weekdayShort.size() <= 12
      && data.timeLabel is string
      && data.timeLabel.size() == 5
      && data.timeLabel.matches('^[0-9]{2}:[0-9]{2}$')
      && data.description is string
      && data.description.size() >= 1
      && data.description.size() <= 160
      && data.category is string
      && data.category.size() >= 1
      && data.category.size() <= 60
      && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 40))
      && data.amount is number
      && data.amount > 0
      && data.amount <= 100000000000
      && data.notes is string
      && data.notes.size() <= 500
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // 4. User Profile Collection (PII isolated to owner)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['baseMonthlyBudget', 'hasConfiguredBudget', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt'])
        );
      allow delete: if false;

      // 5. Private Movements Subcollection (Master Gate via parent user doc)
      match /movements/{movementId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidId(movementId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isSignedIn()
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
        allow create: if isSignedIn()
          && isValidId(userId)
          && isValidId(movementId)
          && isOwner(userId)
          && isValidMovement(incoming(), userId, movementId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isSignedIn()
          && isValidId(userId)
          && isValidId(movementId)
          && isOwner(userId)
          && isValidMovement(incoming(), userId, movementId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'day',
            'dateISO',
            'dateLabel',
            'fullDateLabel',
            'weekdayShort',
            'timeLabel',
            'description',
            'category',
            'paymentMethod',
            'amount',
            'notes',
            'updatedAt'
          ]);
        allow delete: if isSignedIn()
          && isValidId(userId)
          && isValidId(movementId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }
  }
}
